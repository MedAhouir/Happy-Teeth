# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/happy-teeth

# Secret used to sign admin sessions. 32+ random characters.
#   openssl rand -base64 48
JWT_SECRET=

# Needed to create the very first admin from /admin/create in production.
# (Or skip this and run:  npm run seed:admin -- you@clinic.com "long-password")
ADMIN_SETUP_KEY=

# Public URL of the site, used for SEO (sitemap, social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
